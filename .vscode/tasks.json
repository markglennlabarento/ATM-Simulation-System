{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build ATM",
            "type": "shell",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "src/*.cpp",
                "-Iinclude",
                "-o",
                "atm.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the ATM simulation project."
        }
    ]
}